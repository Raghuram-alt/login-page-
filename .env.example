# AI Smart Mobility - Environment Configuration Template
# Copy this file to .env and configure keys if connecting to live external providers.
# In Demo Mode, the built-in deterministic simulation layer provides full fidelity without API keys.

# Map Provider (MapLibre, OpenStreetMap, or Mapbox)
VITE_MAP_PROVIDER=osm
VITE_MAP_API_KEY=your_map_tiles_key_here

# Weather Telemetry Provider (e.g., OpenWeatherMap / IMD)
VITE_WEATHER_API_KEY=your_weather_api_key_here

# Traffic & Congestion Data Provider (e.g., TomTom / Here / OpenTraffic)
VITE_TRAFFIC_API_KEY=your_traffic_api_key_here

# AI Recommendation Engine (OpenAI / Gemini / Anthropic API or Local Engine)
VITE_AI_API_KEY=your_ai_api_key_here
VITE_AI_MODEL=gemini-1.5-flash

# Database Connection (PostgreSQL / PostGIS / Supabase)
DATABASE_URL=postgresql://mobility_user:password@localhost:5432/ai_smart_mobility?schema=public

# Application Environment
VITE_APP_ENV=development
VITE_DEMO_MODE=true
